<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Mike Kabwadi Shisha — Entrepreneur, commerce international & logistique{% endblock %}</title>
        {% block meta %}
            <meta name="description" content="Mike Kabwadi Shisha, entrepreneur congolais basé à Dubaï, spécialisé dans le commerce international, la logistique maritime et la gestion d'entreprises entre les Émirats arabes unis et la RDC.">
            <meta property="og:title" content="Mike Kabwadi Shisha — Entrepreneur & dirigeant">
            <meta property="og:description" content="Construire des ponts économiques solides entre le Moyen-Orient et l'Afrique — import-export, logistique et gestion opérationnelle.">
            <meta property="og:url" content="/">
            <link rel="canonical" href="/">
        {% endblock %}

        <script>
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        </script>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/styles.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/reveal.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-background text-foreground">
        {% block body %}{% endblock %}
    </body>
</html>
